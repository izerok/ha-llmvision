    "services": {
        "image_analyzer": {
            "name": "图片分析器",
            "description": "用 AI 分析一张图片",
            "fields": {
                "provider": {
                    "name": "提供者",
                    "description": "要使用的配置"
                },
                "model": {
                    "name": "模型",
                    "description": "要使用的模型。不选则使用默认模型。",
                    "example": "gpt-4o-mini"
                },
                "message": {
                    "name": "提示词",
                    "description": "模型提示词",
                    "example": "Describe the image"
                },
                "store_in_timeline": {
                    "name": "存入时间线",
                    "description": "在时间线中为此次检测创建新事件。",
                    "example": true
                },
                "use_memory": {
                    "name": "使用记忆",
                    "description": "使用记忆中保存的信息提供额外上下文。须先设置记忆。",
                    "example": true
                },
                "image_file": {
                    "name": "图片文件",
                    "description": "图片的本地路径",
                    "example": "/config/www/tmp/front_door.jpg"
                },
                "image_entity": {
                    "name": "图片实体",
                    "description": "要分析的图片或摄像头实体",
                    "example": "image.front_door_person"
                },
                "include_filename": {
                    "name": "包含文件名",
                    "description": "是否在请求中包含文件名",
                    "example": false
                },
                "target_width": {
                    "name": "目标宽度",
                    "description": "缩小图片的宽度（像素）",
                    "example": 1280
                },
                "max_tokens": {
                    "name": "最大 Token 数",
                    "description": "最多生成的 Token 数",
                    "example": 3000
                },
                "generate_title": {
                    "name": "生成标题",
                    "description": "是否生成标题（用于通知和事件）"
                },
                "expose_images": {
                    "name": "保存关键帧",
                    "description": "保存关键帧。分析过的画面会保存在 /media/llmvision/snapshots，可用于通知，文件路径会包含在返回结果中。",
                    "example": false
                },
                "response_format": {
                    "name": "响应格式",
                    "description": "响应格式：text 为自然语言，json 为结构化数据",
                    "example": "json"
                },
                "structure": {
                    "name": "结构",
                    "description": "定义期望响应结构的 JSON Schema（仅在响应格式为 json 时使用）。如需为时间线事件自动生成标题，请在 Schema 中加入标题字段（例如 \"title\": {\"type\": \"string\", \"description\": \"Event title\"}），并在下方指定字段名。",
                    "example": "{\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\", \"description\": \"Event title\"}, \"description\": {\"type\": \"string\", \"description\": \"Event description\"}, \"confidence\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 100}}, \"required\": [\"title\", \"description\", \"confidence\"], \"additionalProperties\": false}"
                },
                "title_field": {
                    "name": "标题字段名",
                    "description": "JSON Schema 中存放事件标题的字段名（用于时间线）。留空则使用默认标题“检测到移动”。",
                    "example": "title"
                },
                "description_field": {
                    "name": "描述字段名",
                    "description": "JSON Schema 中存放事件描述的字段名（用于时间线）。",
                    "example": "description"
                }
            }
